#!/bin/bash
# EDITOR для вкладок Claude Code в Agentmeister. Имя файла Claude Code показывает в подсказке "ctrl+g to edit in".
# По ⌘⇧T переводит строку ввода на месте, иначе открывает обычный редактор пользователя (AGENTMEISTER_EDITOR).
# Подробности в lib/translate.py, editor_main.
exec /usr/bin/python3 -B "$(dirname "$0")/../lib/translate.py" editor "$@"
