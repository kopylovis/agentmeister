#!/usr/bin/env bash
set -uo pipefail

resolve_root() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")/.." && pwd
}

ROOT=$(resolve_root)
LIBEXEC="$ROOT/libexec/agentmeister"
# CLI внутри Agentmeister.app: __pycache__ рядом с модулями сломал бы подпись приложения
case "$ROOT" in */Contents/Resources/*) export PYTHONDONTWRITEBYTECODE=1 ;; esac

# без аргументов в терминале: меню действий; AGENTMEISTER_NO_MENU=1 (или MNRH_NO_MENU) сразу выбирает проект
if [ $# -eq 0 ] && [ -t 0 ] && [ -t 1 ] && [ -z "${AGENTMEISTER_NO_MENU:-${MNRH_NO_MENU:-}}" ]; then
  exec /usr/bin/python3 "$LIBEXEC/lib/main_menu.py"
fi

case "${1:-}" in
  --harness)
    case "${2:-}" in
      claude)
        shift 2
        if [ "${1:-}" = install ]; then
          shift
          exec /bin/bash "$LIBEXEC/install_claude.sh" "$@"
        fi
        if [ "${1:-}" = status ]; then
          exec /usr/bin/python3 "$LIBEXEC/lib/claude_live.py" "$@"
        fi
        exec "$ROOT/bin/agentmeister" "$@" ;;
      codex) shift 2; exec /usr/bin/python3 "$LIBEXEC/lib/codex_harness.py" "$@" ;;
      *) echo 'agentmeister: --harness требует claude или codex' >&2; exit 2 ;;
    esac ;;
  --version|-v)   cat "$ROOT/VERSION" ;;
  help|-h|--help) exec /bin/bash "$LIBEXEC/cli.sh" -h ;;
  todo|shot|deps) cmd="$1"; shift; exec /usr/bin/python3 "$LIBEXEC/$cmd.py" "$@" ;;
  *)              exec /bin/bash "$LIBEXEC/cli.sh" "$@" ;;
esac
